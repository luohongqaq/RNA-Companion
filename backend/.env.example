# RNA Companion 后端配置示例
# 复制为 backend/.env 后按需修改;所有条目可省略,省略时使用代码内置默认值。
# 应用内"模型设置"页保存后会写回本文件(RNA_REPLY_* 与 DEFAULT_*)。

# ---- 数据与日志 ----
RNA_DATA_ROOT="memory_record/database"
RNA_LOG_DATABASE_PATH="memory_record/database/logs.sqlite3"
RNA_LOG_LEVEL=INFO
RNA_LOG_RETENTION_DAYS=30

# ---- 自动回复模型(OpenAI 兼容接口,如 GLM / DeepSeek / 本地推理服务) ----
# 启用前必须填入 API key,否则后端启动即报错
RNA_REPLY_ENABLED=true
RNA_REPLY_API_KEY=
RNA_REPLY_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RNA_REPLY_MODEL=glm-5.3-flashx
RNA_REPLY_TEMPERATURE=1
RNA_REPLY_MAX_OUTPUT_TOKENS=500
RNA_REPLY_TIMEOUT_SECONDS=30
# GLM-5.3-flash不支持关闭思考,使用low
RNA_REPLY_REASONING_EFFORT=low

# ---- 场景召回(两阶段回复:草稿 → 场景召回 → 语气/视觉润色) ----
# 按当前对话情绪检索该角色的示例对白;是否生效由角色 manifest 的 scene_recall_enabled 决定。
# 需先自备场景对白 JSONL,并执行 python -m api.cli.seed_scenes 构建索引;
# 没有索引时保持关闭;索引缺失时后端会打日志并自动停用场景召回,不影响其余功能
RNA_REPLY_SCENE_ENABLED=false
# 场景数据目录；缺省按角色目录下的 scenes/sessions_train_by_expr 推导
# RNA_REPLY_SCENE_SOURCE_PATH=resources/characters/<character_id>/scenes/sessions_train_by_expr
RNA_REPLY_SCENE_QDRANT_PATH=memory_record/database/scene_qdrant
RNA_REPLY_SCENE_THRESHOLD=0.7
RNA_REPLY_SCENE_TOP_K=3
RNA_REPLY_SCENE_CANDIDATES=30
RNA_REPLY_ANCHOR_POSITION=before_user
RNA_REPLY_EXAMPLE_FORMAT=dialogue

# ---- 本地模型(路径相对 backend/ 解析;用 backend/scripts/download_models.py 下载) ----
RNA_MEMORY_EMBEDDING_PATH=models/bge-m3
RNA_MEMORY_RERANKER_PATH=models/qwen3-reranker-0.6b
# 无 NVIDIA 显卡时改为 cpu
RNA_MEMORY_RERANKER_DEVICE=cuda:0
# 统一使用 DeepSeek tokenizer 统计上下文,独立于回复模型;只读取本地,随仓库打包无需下载
RNA_REPLY_TOKENIZER_PATH=resources/deepseek_v4_tokenizer

# ---- 记忆系统(跨会话长期记忆:把聊天沉淀为 daily/object/topic 记忆,对话时检索相关内容注入上下文) ----
# 启用前需:1) 运行 scripts/download_models.py 下载本地模型;
# 2) 配置记忆模型密钥(RNA_MEMORY_* 或 DEFAULT_* 一组);
# 3) 本地模型已下载。记忆库目录不存在时启动会自动创建
RNA_MEMORY_ENABLED=true
RNA_MEMORY_API_KEY=
RNA_MEMORY_BASE_URL=
RNA_MEMORY_SELECTION_MODEL=
# 留空则沿用选择模型;总结阶段关闭思考
RNA_MEMORY_SUMMARY_MODEL=
# 记忆库 qdrant 本地目录;不存在时启动自动创建空库
# 原库payload没有character_id时,显式绑定其唯一角色;不可自动向所有角色开放
RNA_MEMORY_QDRANT_PATH="memory_record/database/memory_qdrant"
RNA_MEMORY_LEGACY_CHARACTER_ID=
RNA_MEMORY_SEND_THINKING_PARAMETER=true
RNA_MEMORY_TOTAL_SECONDS=12
RNA_MEMORY_TARGET_SECONDS=11
RNA_MEMORY_SELECTION_SECONDS=10
# 记忆选择第一轮前自动检索候选;计入原有搜索额度和时限
RNA_MEMORY_PREFETCH_ENABLED=true

# ---- 记忆回退模型(记忆筛选/总结未单独配置时使用) ----
DEFAULT_API_KEY=
DEFAULT_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-chat

# ---- 后台任务(可选) ----
# 自动回复执行器:后台领取用户消息、执行两阶段流程生成角色回复,聊天自动回复由此驱动;
# 需要 RNA_MEMORY_ENABLED 与 RNA_REPLY_ENABLED 同时开启
RNA_GENERATION_ENABLED=true
RNA_GENERATION_POLL_SECONDS=1
# 后台daily与object生产:两条链并发,独立于在线召回开关
RNA_MEMORY_PRODUCTION_ENABLED=false
RNA_MEMORY_PRODUCTION_POLL_SECONDS=1
