{
  "name": "rna-companion",
  "version": "0.1.0",
  "description": "RNA Companion - Electron + Vue 3 + Python 三层后端架构",
  "author": "落红",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "chcp 65001 >nul && vite --mode electron",
    "build": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json && vite build",
    "electron:build": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json && vite build --mode electron",
    "electron:dist": "npm run electron:build && electron-builder --win --config electron-builder.yml",
    "preview": "vite preview",
    "backend:dev": "chcp 65001 >nul && ../backend/.venv/Scripts/python.exe ../backend/server.py"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "42.4.1",
    "electron-builder": "^26.0.0",
    "typescript": "~5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.0"
  }
}
